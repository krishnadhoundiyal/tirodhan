# Local development only. Do not reuse these credentials outside local development.
TIRODHAN_ENVIRONMENT=local
TIRODHAN_DEBUG=false
TIRODHAN_LOG_LEVEL=INFO
# For hosted environments, set this to the application log file on the mounted shared volume.
# TIRODHAN_LOG_FILE_PATH=
TIRODHAN_DATABASE_URL=postgresql+asyncpg://tirodhan:tirodhan@localhost:5432/tirodhan
TIRODHAN_DATABASE_ECHO=false
# Values remain product/operations configuration; no retention duration is frozen here.
# TIRODHAN_COMMAND_IDEMPOTENCY_TTL_SECONDS=
# TIRODHAN_SERVICEABILITY_CONTEXT_TTL_SECONDS=
# TIRODHAN_PENDING_PAYMENT_LIFETIME_SECONDS=
# Authentication lifetimes are product configuration and must be set explicitly.
# TIRODHAN_AUTH_ACCESS_TOKEN_TTL_SECONDS=
# TIRODHAN_AUTH_REFRESH_SESSION_TTL_SECONDS=
# TIRODHAN_AUTH_TOKEN_ISSUER=
# TIRODHAN_AUTH_TOKEN_AUDIENCE=
# PEM keys should be supplied through secure environment/secret configuration.
# TIRODHAN_AUTH_JWT_PRIVATE_KEY_PEM=
# TIRODHAN_AUTH_JWT_PUBLIC_KEY_PEM=
# Planning product values remain intentionally unset until configured per environment.
# TIRODHAN_PLANNING_LEAD_TIME_MINUTES=
# TIRODHAN_PLANNING_MAX_ATTEMPTS=
# TIRODHAN_PLANNING_COMPACTION_DISTANCE_M=
# TIRODHAN_PLANNING_MAX_GROUP_REQUESTS=
