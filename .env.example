# Local development only. Do not reuse these credentials outside local development.
TIRODHAN_ENVIRONMENT=local
TIRODHAN_DEBUG=false
TIRODHAN_LOG_LEVEL=INFO
# For hosted environments, set this to the application log file on the mounted shared volume.
# TIRODHAN_LOG_FILE_PATH=
TIRODHAN_DATABASE_URL=postgresql+asyncpg://tirodhan:tirodhan@localhost:5432/tirodhan
TIRODHAN_DATABASE_ECHO=false
# Phase 1T: Key Vault -> ACA secret reference; never put real Google keys here.
# TIRODHAN_GOOGLE_MAPS_API_KEY=
# TIRODHAN_GOOGLE_MAPS_HTTP_TIMEOUT_SECONDS=
# TIRODHAN_GOOGLE_MAPS_DELHI_ADMIN_ALIASES=["Delhi","DL","National Capital Territory of Delhi","NCT of Delhi"]
# H3 resolution is fixed at 7, not environment-configurable.
# Service Bus uses DefaultAzureCredential, never a production connection string.
# TIRODHAN_SERVICE_BUS_NAMESPACE=<namespace>.servicebus.windows.net
# TIRODHAN_SERVICEABILITY_QUEUE_NAME=
# TIRODHAN_SERVICE_BUS_MANAGED_IDENTITY_CLIENT_ID=
# TIRODHAN_SERVICE_BUS_OPERATION_TIMEOUT_SECONDS=
# TIRODHAN_SERVICEABILITY_LOCK_RENEWAL_SECONDS=
# TIRODHAN_OUTBOX_PUBLISH_BATCH_SIZE=
# Values remain product/operations configuration; no retention duration is frozen here.
# TIRODHAN_COMMAND_IDEMPOTENCY_TTL_SECONDS=
# TIRODHAN_SERVICEABILITY_CONTEXT_TTL_SECONDS=
# TIRODHAN_PENDING_PAYMENT_LIFETIME_SECONDS=
# Authentication lifetimes are product configuration and must be set explicitly.
# TIRODHAN_AUTH_ACCESS_TOKEN_TTL_SECONDS=
# TIRODHAN_AUTH_REFRESH_SESSION_TTL_SECONDS=
# Tirodhan intent TTL must be intentionally aligned with the Kaleyra flow's provider OTP expiry.
# TIRODHAN_AUTH_OTP_CHALLENGE_TTL_SECONDS=
# Kaleyra uses only transaction-bound Verify; incomplete configuration fails closed.
# TIRODHAN_KALEYRA_API_DOMAIN=https://<configured-regional-host>
# TIRODHAN_KALEYRA_SID=
# TIRODHAN_KALEYRA_API_KEY=
# TIRODHAN_KALEYRA_VERIFY_FLOW_ID=
# TIRODHAN_KALEYRA_HTTP_TIMEOUT_SECONDS=
# Secrets: Key Vault -> ACA secret/reference -> process config (no production values in Git).
# Keys are strict standard base64; AES keyring is a JSON object mapping retained IDs to 32-byte keys.
# TIRODHAN_PHONE_ENCRYPTION_ACTIVE_KEY_ID=
# TIRODHAN_PHONE_ENCRYPTION_KEYS=
# TIRODHAN_PHONE_LOOKUP_HMAC_KEY=
# Encryption key rotation retains old IDs. Lookup HMAC rotation requires a maintenance migration.
# Address protection uses an independent AES keyring with the same rotation semantics.
# TIRODHAN_ADDRESS_ENCRYPTION_ACTIVE_KEY_ID=
# TIRODHAN_ADDRESS_ENCRYPTION_KEYS=
# TIRODHAN_AUTH_TOKEN_ISSUER=
# TIRODHAN_AUTH_TOKEN_AUDIENCE=
# PEM keys should be supplied through secure environment/secret configuration.
# TIRODHAN_AUTH_JWT_PRIVATE_KEY_PEM=
# TIRODHAN_AUTH_JWT_PUBLIC_KEY_PEM=
# Planning product values remain intentionally unset until configured per environment.
# TIRODHAN_PLANNING_LEAD_TIME_MINUTES=
# TIRODHAN_PLANNING_MAX_ATTEMPTS=
# TIRODHAN_PLANNING_COMPACTION_DISTANCE_M=
# TIRODHAN_PLANNING_MAX_GROUP_REQUESTS=
# Phase 1U: deployment must set queue and offer duration; no product lifetime default.
# TIRODHAN_RIDER_NOTIFICATION_QUEUE_NAME=
# Positive broker lock-renewal duration; required by the rider notification worker.
# TIRODHAN_RIDER_NOTIFICATION_LOCK_RENEWAL_SECONDS=
# TIRODHAN_RIDER_OFFER_LIFETIME_SECONDS=
# Firebase service-account JSON arrives through runtime secrets, never a committed file.
# TIRODHAN_FCM_PROJECT_ID=
# TIRODHAN_FCM_CREDENTIALS_JSON=
# Phase 1V: all Razorpay credentials and bounded HTTP timeout must be configured together.
# TIRODHAN_RAZORPAY_KEY_ID=
# TIRODHAN_RAZORPAY_KEY_SECRET=
# TIRODHAN_RAZORPAY_WEBHOOK_SECRET=
# TIRODHAN_RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
# TIRODHAN_RAZORPAY_HTTP_TIMEOUT_SECONDS=
# Dedicated refund runtime queue and positive broker renewal duration.
# TIRODHAN_REFUND_QUEUE_NAME=
# TIRODHAN_REFUND_LOCK_RENEWAL_SECONDS=
